PORT=3978

# PostgreSQL local
DATABASE_URL=postgresql://postgres:password@localhost:5432/teams_tracker

# Groq keyt
GROQ_API_KEY=replace_with_your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile

# SerpApi
SERPAPI_KEY=replace_with_your_serpapi_key

# Opcionales para conectar el bot con Microsoft Teams
MICROSOFT_APP_ID=
MICROSOFT_APP_PASSWORD=
MICROSOFT_APP_TENANT_ID=